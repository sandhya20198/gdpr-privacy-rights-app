{
  "name": "@facilio/vibe-sdk",
  "version": "0.3.1",
  "description": "Browser SDK for Vibe \u2014 login/logout against Facilio identity-service, scoped to the vibe service.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.global.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "example:build": "npm run build",
    "example": "npm run example:build && echo '\\nOpen http://localhost:5500/examples/smoke-test/\\n' && python3 -m http.server 5500"
  },
  "keywords": [
    "facilio",
    "vibe",
    "sdk",
    "auth",
    "identity"
  ],
  "author": "Facilio",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
